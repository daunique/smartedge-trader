# SmartEdge Trader — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# -- App --------------------------------------------------------------
NODE_ENV=production
PORT=10000

# -- Bybit Exchange -----------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true   # Set to false for live trading

# -- Trading Defaults -----------------------------------------------------
# Per-symbol risk-per-trade is set in code (backend/app/engine/auto_executor.py
# RISK_PER_TRADE_PCT), not here, since XRP and ETH intentionally use different
# values -- see README.
ACCOUNT_MODE=DEMO
