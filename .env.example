# SmartEdge Trader — Environment Variables
# NEVER commit real secrets to git

# -- Bybit --------------------------------------------------------------
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true
ACCOUNT_MODE=DEMO

# -- Frontend (build-time for Vite) -------------------------------------
# VITE_API_URL=https://smartedge-api.fly.dev

# -- Keep-alive / public URL --------------------------------------------
# Render sets RENDER_EXTERNAL_URL automatically.
# Fly sets FLY_APP_NAME automatically (backend builds https://{app}.fly.dev).
# Optional override:
# SELF_URL=https://smartedge-api.fly.dev
